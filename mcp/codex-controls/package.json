{
  "name": "claude-codex-controls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/app/server.ts",
    "check": "oxlint --type-aware --type-check --max-warnings 0 --report-unused-disable-directives",
    "test": "bun test ./tests",
    "format": "oxfmt --write src tests scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src tests scripts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "smoke:plugins": "bun scripts/smoke-plugins.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "type-fest": "^5.10.0"
  }
}
