{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "350000",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "0",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "900000",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_TETHER_LIVE": "0",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8318",
    "ANTHROPIC_API_KEY": "vibeproxy",
    "NO_PROXY": "127.0.0.1,localhost"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [],
    "defaultMode": "bypassPermissions",
    "skipDangerousModePermissionPrompt": true,
    "deny": [
      "mcp__computer-use__*",
      "mcp__claude-in-chrome__*",
      "mcp__playwright__*"
    ]
  },
  "model": "claude-opus-5-5",
  "modelPicker": {
    "options": [
      {
        "model": "claude-opus-5-5",
        "label": "Opus 5.5",
        "description": "Claude Opus 5.5 (Anthropic)"
      },
      {
        "model": "claude-sonnet-5-5",
        "label": "Sonnet 5.5",
        "description": "Claude Sonnet 5.5 (Anthropic)"
      },
      {
        "model": "claude-fable-5-1",
        "label": "Fable 5.1",
        "description": "Claude Fable 5.1 (Anthropic)"
      },
      {
        "model": "gpt-6.1-sol",
        "label": "Sol 6.1",
        "description": "GPT-6.1 Sol (OpenAI (ChatGPT))"
      },
      {
        "model": "gpt-6-astra",
        "label": "Astra 6",
        "description": "GPT-6 Astra (OpenAI (ChatGPT))"
      },
      {
        "model": "gpt-6-luna",
        "label": "Luna 6",
        "description": "GPT-6 Luna (OpenAI (ChatGPT))"
      }
    ],
    "replaceBuiltInOptions": true
  },
  "skillOverrides": {
    "claude-api": "off"
  },
  "worktree": {
    "symlinkDirectories": [],
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-native-lsp@native-typescript-lsp": true
  },
  "extraKnownMarketplaces": {
    "native-typescript-lsp": {
      "source": {
        "source": "directory",
        "path": "/Users/cgas/.claude/local-marketplaces/native-typescript-lsp"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "medium",
  "modelSettings": {
    "grok": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "gpt-6.1-sol": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactWindow": 350000
}
