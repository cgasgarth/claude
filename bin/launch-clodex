#!/bin/zsh
set -euo pipefail

export CLODEX_WORKFLOW_STALL_TIMEOUT_MS="${CLODEX_WORKFLOW_STALL_TIMEOUT_MS:-600000}"

claude_settings="${HOME}/.claude/settings.json"

if [[ ! -r "$claude_settings" ]]; then
  print -u2 "Claude settings are missing."
  exit 1
fi

model_setting="$(jq -r '.model // empty' "$claude_settings")"

if [[ -z "$model_setting" ]]; then
  print -u2 "Claude's default model is not configured."
  exit 1
fi

claude_args=("$@")
for arg in "$@"; do
  case "$arg" in
    --worktree|-w|--worktree=*)
      exec clodex claude --endpoint -- --model "$model_setting" "${claude_args[@]}"
      ;;
  esac
done

# Endpoint mode routes the saved short alias through the persistent Clodex daemon.
# The daemon owns shared WebSocket/cache/compaction state for the main process,
# workflows, subagents, and background sessions.
exec clodex claude --endpoint -- --model "$model_setting" --worktree "${claude_args[@]}"
